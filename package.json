{
    "name": "retro-refresher",
    "version": "1.1.0",
    "description": "A retro-styled desktop refresher application with cross-platform support",
    "main": "main.js",
    "author": "Anacondy",
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:win": "electron-builder --win",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux",
        "build:all": "electron-builder -mwl",
        "postinstall": "electron-builder install-app-deps"
    },
    "dependencies": {
        "koffi": "^2.6.0"
    },
    "devDependencies": {
        "electron": "^42.5.0",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.anacondy.retro-refresher",
        "productName": "Retro Desktop Refresher",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "index.html"
        ],
        "asarUnpack": [
            "node_modules/koffi/**/*"
        ],
        "win": {
            "target": [{
                "target": "nsis",
                "arch": ["ia32", "x64"]
            }]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": true
        },
        "compression": "maximum",
        "mac": {
            "target": [{
                "target": "dmg",
                "arch": ["x64", "arm64"]
            }],
            "category": "public.app-category.utilities"
        },
        "linux": {
            "target": ["AppImage"],
            "category": "Utility",
            "icon": "linux-icon.png"
        },
        "publish": null
    }
}
